{
  "name": "alisales",
  "version": "0.1.0",
  "private": true,
  "author": "Mahsa Sadr / Miva Tech",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "infisical run --env=dev -- supabase start",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:db": "tsx scripts/smoke-db.ts",
    "measure:pagination": "tsx scripts/measure-search-pagination.ts",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "auth:e2e": "node scripts/e2e-auth.mjs",
    "e2e": "playwright test",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.5",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
