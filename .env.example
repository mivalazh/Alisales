# ── Supabase (apps fall back to seeded local fixtures when unset) ─────────────
SUPABASE_URL=
# Server key for writes (publish, uploads, chat). Either name works and is read
# through one accessor: the legacy service-role key, or a newer Supabase secret
# key, which the dashboard labels `sb_secret_…`.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A production build refuses to ship an empty catalogue: missing public
# Supabase values, or a read that returns no rows or fails while pages
# prerender. Set the two values above for real builds; opt out here only for an
# intentional empty catalogue. See DEPLOY_RUNBOOK.md.
ALLOW_EMPTY_CATALOGUE=
# CI and the Freebuff Sites build (apps/web/.env.production.local, gitignored)
# set this for their credential-less builds. A real deploy never sets it.

# ── Demo / development mode ──────────────────────────────────────────────────
# Production builds require Supabase for data. Set this to true only in a
# non-production environment to force the same strict data behavior.
REQUIRE_HOSTED_SERVICES=

# The seeded demo catalogue. It is hidden by default in a production build, so
# a live site can only show real listings, and kept in development for local
# work. Any value other than false/0/no/off hides it; only an explicit opt-out
# ships the seed on a production build (a deliberate demo, not a launch). The
# setting is build-time: change it and rebuild. See DEPLOY_RUNBOOK.md.
NEXT_PUBLIC_HIDE_DEMO_LISTINGS=

# Instant OTP (no SMS provider yet): development allows every number, but
# production allows only these comma-separated launch accounts. Leave empty in
# production to block instant OTP entirely. Normalized +98/0098 forms work.
INSTANT_OTP_ALLOWLIST=

# Legacy, off by default, and no longer needed: allowlisted numbers already get
# the login code on screen automatically when the SMS gateway cannot deliver
# (sandbox/unverified account, template rejection, provider error). The
# allowlist above is the account-takeover boundary — keep it minimal. Leave this
# unset; see LOGIN_RUNBOOK.md.
ALLOW_SANDBOX_OTP_FALLBACK=

# Session signing secret. Production requires a real value (≥16 chars); a
# missing value disables sessions rather than falling back to a known demo key.
AUTH_SECRET=

# ── SMS provider ─────────────────────────────────────────────────────────────
# Preferred: SMS.ir Fast Verification. The template must be approved and
# contain CODE/code. The template id is required; there is no implicit default.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=

# Generic adapter (Kavenegar etc.): POST JSON { to, from, text } with Bearer
# SMS_API_KEY. A bare SMS_API_KEY with no URL is treated as an SMS.ir key.
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=

# Optional moderation allow-list, comma-separated mobile numbers.
ADMIN_PHONES=

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Expo / native app ─────────────────────────────────────────────────────────
# Public web origin used by the native app for links and future REST calls.
# Supabase reads/writes use the two public values above from the Expo env too.
EXPO_PUBLIC_API_URL=https://alisales.ir
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Payments (Zarinpal behind the PaymentProvider adapter) ───────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_MODE=sandbox
