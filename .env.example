# ── Supabase (apps fall back to seeded local fixtures when unset) ─────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Demo / preview mode ───────────────────────────────────────────────────────
# Without Supabase or SMS credentials the web app keeps its fixture store on
# disk (production preview builds included) and prints login codes to the
# server log. Set this to true to refuse that fallback and answer 503 instead.
REQUIRE_HOSTED_SERVICES=

# Preview-only switch: when the deployment is fixture/demo (no Supabase, no SMS)
# the login code step also shows the code from the server log, so the owner can
# sign in on a shared preview link. Always leave empty/false on a real deployment.
NEXT_PUBLIC_DEMO_OTP_HINT=

# Session signing secret. A fixture/demo deployment falls back to a labelled
# demo secret; a hosted deployment requires a real value (≥16 chars).
AUTH_SECRET=

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Expo / native app ─────────────────────────────────────────────────────────
# Public web origin used by the native app for links and future REST calls.
# Supabase reads/writes use the two public values above from the Expo env too.
EXPO_PUBLIC_API_URL=https://alisales.ir
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Payments (Zarinpal behind the PaymentProvider adapter) ───────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_MODE=sandbox
