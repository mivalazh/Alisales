# ── Supabase (apps fall back to seeded local fixtures when unset) ─────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Demo / development mode ──────────────────────────────────────────────────
# Production builds are always strict: without Supabase/SMS they answer 503
# instead of falling back to fixture data or demo OTP. Set this to true only in
# a non-production environment to force that same strict behavior.
REQUIRE_HOSTED_SERVICES=

# Development-only switch: in a fixture session the login code step can show
# the code from the server log. Production ignores this and never returns a
# demo code.
NEXT_PUBLIC_DEMO_OTP_HINT=

# Session signing secret. Production requires a real value (≥16 chars); a
# missing value disables sessions rather than falling back to a known demo key.
AUTH_SECRET=

# ── SMS provider ─────────────────────────────────────────────────────────────
# Generic adapter: POST JSON { to, from, text } with Bearer SMS_API_KEY.
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=

# Optional moderation allow-list, comma-separated mobile numbers.
ADMIN_PHONES=

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Expo / native app ─────────────────────────────────────────────────────────
# Public web origin used by the native app for links and future REST calls.
# Supabase reads/writes use the two public values above from the Expo env too.
EXPO_PUBLIC_API_URL=https://alisales.ir
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Payments (Zarinpal behind the PaymentProvider adapter) ───────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_MODE=sandbox
