{
  "expo": {
    "name": "Ali Sales",
    "slug": "alisales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alisales",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ir.alisales.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fa_IR",
        "CFBundleAllowMixedLocalizations": true,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSPhotoLibraryUsageDescription": "برای افزودن عکس خودرو به آگهی، به دسترسی گالری نیاز است.",
        "NSCameraUsageDescription": "برای گرفتن عکس خودرو و افزودن آن به آگهی، به دوربین نیاز است."
      }
    },
    "android": {
      "package": "ir.alisales.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#111144",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["READ_MEDIA_IMAGES", "CAMERA"]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111144",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 130
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای افزودن عکس خودرو به آگهی، به دسترسی گالری نیاز است."
        }
      ]
    ],
    "extra": {
      "rtl": true,
      "supportsRTL": true,
      "apiUrlEnv": "EXPO_PUBLIC_API_URL",
      "supabaseUrlEnv": "EXPO_PUBLIC_SUPABASE_URL",
      "supabaseAnonKeyEnv": "EXPO_PUBLIC_SUPABASE_ANON_KEY"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
